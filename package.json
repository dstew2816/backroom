{
  "name": "backroom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local search over a game master's own Markdown notes. Finds and ranks existing ideas; never generates text.",
  "scripts": {
    "test": "vitest run",
    "chunks": "tsx scripts/preview.ts",
    "index": "tsx scripts/index.ts",
    "start": "tsx scripts/serve.ts",
    "search": "tsx scripts/search.ts",
    "used": "tsx scripts/used.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1"
  }
}
